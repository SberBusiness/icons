{
    "name": "@sberbusiness/icons-monorepo",
    "author": "СберБизнес",
    "license": "Sber Public License at-nc-sa v.2",
    "private": true,
    "scripts": {
        "clean": "ts-node ./tools/tasks/clean.ts",
        "generate:icons": "cross-env TARGET=icons ts-node ./tools-legacy/generator/generateReact",
        "generate:illustrations": "cross-env TARGET=illustrations ts-node ./tools-legacy/generator/generateReact",
        "generate:icons-next": "ts-node ./tools/generator/generateReact",
        "generate:svg:icons": "cross-env TARGET=icons ts-node ./tools-legacy/generator/generateSVG",
        "generate:svg:icons-next": "ts-node ./tools/generator/generateSVG",
        "ts-dts:icons": "tsc -p ./packages/icons/tsconfig.generated.json",
        "ts-dts:illustrations": "tsc -p ./packages/illustrations/tsconfig.generated.json",
        "ts-dts:icons-next": "tsc -p ./packages/icons-next/tsconfig.generated.json",
        "copy:icons": "cross-env TARGET=icons ts-node ./tools-legacy/tasks/copy.ts",
        "copy:illustrations": "cross-env TARGET=illustrations ts-node ./tools-legacy/tasks/copy.ts",
        "copy:icons-next": "ts-node ./tools/tasks/copy.ts",
        "build:icons": "npm run clean && npm run generate:icons && npm run ts-dts:icons && npm run copy:icons",
        "build:illustrations": "npm run clean && npm run generate:illustrations && npm run ts-dts:illustrations && npm run copy:illustrations",
        "build:icons-next": "npm run clean && npm run generate:icons-next && npm run ts-dts:icons-next && npm run copy:icons-next",
        "publish:icons": "npm run build:icons && npm publish --access public ./public",
        "publish:illustrations": "npm run build:illustrations && npm publish --access public ./public",
        "publish:icons-next": "npm run build:icons-next && npm publish --access public ./public",
        "prettier": "prettier --write tools/**/*.ts",
        "test:hash": "node --test --require ts-node/register ./tests/hash.ts"
    },
    "devDependencies": {
        "@types/node": "18.0.0",
        "@types/react": "16.8.0",
        "copy": "0.3.2",
        "crc-32": "1.2.2",
        "cross-env": "7.0.3",
        "prettier": "3.2.5",
        "rimraf": "3.0.0",
        "svgo": "3.2.0",
        "ts-node": "10.9.2",
        "typescript": "5.3.3"
    },
    "peerDependencies": {
        "react": ">=16.8.0"
    }
}
